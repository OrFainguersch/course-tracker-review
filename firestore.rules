rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && currentUserRecord().data.status == 'active';
    }

    function owner() {
      return activeUser()
        && currentUserRecord().data.role == 'owner';
    }

    function administrator() {
      return activeUser()
        && currentUserRecord().data.role in ['owner', 'admin'];
    }

    function userManager() {
      return activeUser()
        && currentUserRecord().data.role in ['owner', 'admin', 'training_manager'];
    }

    function systemAccessExists() {
      return exists(/databases/$(database)/documents/system/access);
    }

    function systemOwnerUid() {
      return get(/databases/$(database)/documents/system/access).data.ownerUid;
    }

    function validRoleAndStatus(data) {
      return data.role in ['user', 'duty_trainee', 'training_manager', 'admin', 'owner']
        && data.status in ['pending', 'active', 'blocked'];
    }

    function validUserShape(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'displayName', 'preferredName', 'photoURL', 'providerIds',
        'role', 'status', 'createdAt', 'lastLoginAt', 'updatedAt', 'updatedBy'
      ]) && validRoleAndStatus(data);
    }

    function validInviteShape(data) {
      return data.keys().hasOnly([
        'email', 'displayName', 'role', 'status',
        'createdAt', 'updatedAt', 'invitedBy'
      ])
        && data.email == data.email.lower()
        && data.role in ['user', 'duty_trainee', 'training_manager', 'admin', 'owner']
        && data.status == 'active';
    }

    function invitedUserCreate(data) {
      let email = request.auth.token.email.lower();
      return exists(/databases/$(database)/documents/invitations/$(email))
        && get(/databases/$(database)/documents/invitations/$(email)).data.email == email
        && get(/databases/$(database)/documents/invitations/$(email)).data.status == 'active'
        && data.email == email
        && data.role == get(/databases/$(database)/documents/invitations/$(email)).data.role
        && data.status == 'active';
    }

    function selfProfileOnly(uid) {
      return ownUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          resource.data.role == 'duty_trainee'
          ? ['photoURL', 'providerIds', 'lastLoginAt', 'updatedAt']
          : ['preferredName', 'photoURL', 'providerIds', 'lastLoginAt', 'updatedAt']
        );
    }

    function ownerSelfIdentity(uid) {
      return owner()
        && ownUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'preferredName', 'photoURL', 'updatedAt', 'updatedBy'
        ]);
    }

    function ownerBootstrap(uid) {
      return ownUser(uid)
        && resource.data.role == 'admin'
        && resource.data.status == 'active'
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && systemAccessExists()
        && systemOwnerUid() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'updatedAt', 'updatedBy'
        ]);
    }

    function roleMayBeGranted(actorRole, nextRole) {
      return (actorRole == 'owner' && nextRole in ['owner', 'admin', 'training_manager', 'duty_trainee', 'user'])
        || (actorRole == 'admin' && nextRole in ['training_manager', 'duty_trainee', 'user'])
        || (actorRole == 'training_manager' && nextRole in ['duty_trainee', 'user']);
    }

    function managerMayTarget(actorRole, targetRole, uid) {
      return uid != request.auth.uid
        && !(targetRole == 'owner' && systemAccessExists() && uid == systemOwnerUid())
        && ((actorRole == 'owner')
          || (actorRole == 'admin' && targetRole in ['training_manager', 'duty_trainee', 'user'])
          || (actorRole == 'training_manager' && targetRole in ['duty_trainee', 'user']));
    }

    function managerManagesOther(uid) {
      let actorRole = currentUserRecord().data.role;
      let currentRole = resource.data.role;
      let nextRole = request.resource.data.role;
      return userManager()
        && managerMayTarget(actorRole, currentRole, uid)
        && (nextRole == currentRole
          || roleMayBeGranted(actorRole, nextRole)
          || (actorRole == 'owner'
            && ((currentRole == 'owner' && nextRole in ['admin', 'training_manager', 'user'])
              || (currentRole == 'admin' && nextRole in ['training_manager', 'duty_trainee', 'user'])
              || (currentRole == 'training_manager' && nextRole in ['duty_trainee', 'user'])))
          || (actorRole == 'admin'
            && currentRole == 'training_manager'
            && nextRole == 'user'));
    }

    function managerMayDelete(uid) {
      let actorRole = currentUserRecord().data.role;
      let targetRole = resource.data.role;
      return userManager()
        && managerMayTarget(actorRole, targetRole, uid);
    }

    function mayManageInvitationRole(role) {
      let actorRole = currentUserRecord().data.role;
      return userManager()
        && (actorRole == 'owner'
          || (actorRole == 'admin' && role in ['training_manager', 'duty_trainee', 'user'])
          || (actorRole == 'training_manager' && role in ['duty_trainee', 'user']));
    }

    function mayGrantInvitationRole(role) {
      return userManager()
        && roleMayBeGranted(currentUserRecord().data.role, role);
    }

    match /users/{uid} {
      /* First sign-in may only create the caller's own pending USER record.
         A valid invitation may pre-authorize the exact role granted by the
         inviter's hierarchy: Owner -> Owner/Admin, Admin -> Training Manager,
         Training Manager -> User. The immutable /system/access ownerUid still
         identifies the protected Primary Owner. */
      allow create: if ownUser(uid)
        && validUserShape(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && ((request.resource.data.role == 'user'
          && request.resource.data.status == 'pending')
          || invitedUserCreate(request.resource.data));

      allow read: if ownUser(uid) || userManager();

      /* User Management is hierarchical. Owner may appoint another Owner or an
         Administrator; Admin may appoint a Training Manager; Training Manager
         may appoint a User. Managers may approve/block lower roles, while the
         Primary Owner in /system/access remains protected. */
      allow update: if validUserShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (managerManagesOther(uid)
          || ownerBootstrap(uid)
          || ownerSelfIdentity(uid)
          || selfProfileOnly(uid));

      allow delete: if managerMayDelete(uid);
    }

    match /invitations/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list: if userManager();
      allow create: if userManager()
        && validInviteShape(request.resource.data)
        && request.resource.data.email == email
        && mayGrantInvitationRole(request.resource.data.role);
      allow update: if userManager()
        && validInviteShape(request.resource.data)
        && request.resource.data.email == email
        && mayManageInvitationRole(resource.data.role)
        && (request.resource.data.role == resource.data.role
          || mayGrantInvitationRole(request.resource.data.role));
      allow delete: if userManager()
        && mayManageInvitationRole(resource.data.role);
    }

    match /system/access {
      allow read: if administrator();

      /* Existing legacy Admins race only for this first immutable claim. Once
         created, no additional Admin can become Owner from the client. */
      allow create: if administrator()
        && !systemAccessExists()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'createdAt', 'createdBy'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    /* Shared Safety is an explicitly enrolled, UID-verified exception to the
       device-local training store. The client cannot grant course access. */
    match /courseSafety/{courseId} {
      function member() {
        return activeUser()
          && exists(/databases/$(database)/documents/courseSafety/$(courseId))
          && request.auth.uid in get(/databases/$(database)/documents/courseSafety/$(courseId)).data.members.keys();
      }
      function manager() {
        return userManager()
          || (member()
            && get(/databases/$(database)/documents/courseSafety/$(courseId)).data.members[request.auth.uid].role == 'COURSE_MANAGER');
      }
      function memberUids() {
        return get(/databases/$(database)/documents/courseSafety/$(courseId)).data.members.keys().toSet();
      }

      allow get: if userManager() || member();
      allow list: if activeUser()
        && request.auth.uid in resource.data.memberUids;
      allow create: if userManager()
        && request.resource.data.keys().hasOnly(['courseId','name','members','memberUids','updatedAt','updatedBy'])
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 100
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.toSet() == request.resource.data.members.keys().toSet()
        && request.auth.uid in request.resource.data.members.keys()
        && request.resource.data.members[request.auth.uid].role == 'COURSE_MANAGER'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if userManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','memberUids','updatedAt','updatedBy'])
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 100
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.toSet() == request.resource.data.members.keys().toSet()
        && request.auth.uid in request.resource.data.members.keys()
        && request.resource.data.members[request.auth.uid].role == 'COURSE_MANAGER'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /events/{eventId} {
        function eventKeys() {
          return ['id','courseId','date','traineeId','instructorId','traineeName',
            'instructorName','title','severity','classification','details','briefDescription',
            'findings','lessonsLearned','photos','status','createdBy','createdAt',
            'requiredAckUids','requiredAckNames','seenBy','ackBy','statusBy','statusAt'];
        }
        function ownMark(field) {
          return member()
            && request.auth.uid in resource.data.requiredAckUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
            && request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in resource.data[field].keys())
            && request.resource.data[field][request.auth.uid] == request.time;
        }
        allow get, list: if member() || userManager();
        allow create: if member()
          && request.resource.data.keys().hasOnly(eventKeys())
          && request.resource.data.id == eventId
          && request.resource.data.courseId == get(/databases/$(database)/documents/courseSafety/$(courseId)).data.courseId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'OPEN'
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 250
          && request.resource.data.seenBy == {}
          && request.resource.data.ackBy == {}
          && request.resource.data.requiredAckUids is list
          && request.resource.data.requiredAckUids.toSet() == memberUids();
        allow update: if ownMark('seenBy')
          || (ownMark('ackBy') && request.auth.uid in resource.data.seenBy.keys())
          || (manager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusBy','statusAt'])
            && request.resource.data.status in ['OPEN','IN_PROGRESS','RESOLVED']
            && request.resource.data.statusBy == request.auth.uid
            && request.resource.data.statusAt == request.time);
        allow delete: if false;
      }
    }

    /* Other training/course collections remain fail-closed until a separate
       migration from device storage and complete UID/course rules. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
