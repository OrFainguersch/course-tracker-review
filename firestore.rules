rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && currentUserRecord().data.status == 'active';
    }

    function owner() {
      return activeUser()
        && currentUserRecord().data.role == 'owner';
    }

    function administrator() {
      return activeUser()
        && currentUserRecord().data.role in ['owner', 'admin'];
    }

    function systemAccessExists() {
      return exists(/databases/$(database)/documents/system/access);
    }

    function systemOwnerUid() {
      return get(/databases/$(database)/documents/system/access).data.ownerUid;
    }

    function validRoleAndStatus(data) {
      return data.role in ['user', 'training_manager', 'admin', 'owner']
        && data.status in ['pending', 'active', 'blocked'];
    }

    function validUserShape(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'providerIds',
        'role', 'status', 'createdAt', 'lastLoginAt', 'updatedAt', 'updatedBy'
      ]) && validRoleAndStatus(data);
    }

    function validInviteShape(data) {
      return data.keys().hasOnly([
        'email', 'displayName', 'role', 'status',
        'createdAt', 'updatedAt', 'invitedBy'
      ])
        && data.email == data.email.lower()
        && data.role in ['user', 'training_manager', 'admin']
        && data.status == 'active';
    }

    function invitedUserCreate(data) {
      let email = request.auth.token.email.lower();
      return exists(/databases/$(database)/documents/invitations/$(email))
        && get(/databases/$(database)/documents/invitations/$(email)).data.email == email
        && get(/databases/$(database)/documents/invitations/$(email)).data.status == 'active'
        && data.email == email
        && data.role == get(/databases/$(database)/documents/invitations/$(email)).data.role
        && data.status == 'active';
    }

    function selfProfileOnly(uid) {
      return ownUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'providerIds', 'lastLoginAt', 'updatedAt'
        ]);
    }

    function ownerBootstrap(uid) {
      return ownUser(uid)
        && resource.data.role == 'admin'
        && resource.data.status == 'active'
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && systemAccessExists()
        && systemOwnerUid() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'updatedAt', 'updatedBy'
        ]);
    }

    function administratorManagesOther(uid) {
      return administrator()
        && uid != request.auth.uid
        && resource.data.role != 'owner'
        && request.resource.data.role != 'owner';
    }

    match /users/{uid} {
      /* First sign-in may only create the caller's own pending USER record.
         An invitation may pre-authorize USER, TRAINING_MANAGER or ADMIN.
         OWNER is established separately through the one-time bootstrap below. */
      allow create: if ownUser(uid)
        && validUserShape(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && ((request.resource.data.role == 'user'
          && request.resource.data.status == 'pending')
          || invitedUserCreate(request.resource.data));

      allow read: if ownUser(uid) || administrator();

      /* Owner/Admin may manage other accounts, but nobody can create a second
         Owner through User Management. The original Owner account is protected.
         A legacy active Admin may promote only itself after winning the
         one-time /system/access ownership claim. */
      allow update: if validUserShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (administratorManagesOther(uid)
          || ownerBootstrap(uid)
          || selfProfileOnly(uid));

      allow delete: if administrator()
        && uid != request.auth.uid
        && resource.data.role != 'owner';
    }

    match /invitations/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list: if administrator();
      allow create, update: if administrator()
        && validInviteShape(request.resource.data)
        && request.resource.data.email == email;
      allow delete: if administrator();
    }

    match /system/access {
      allow read: if administrator();

      /* Existing legacy Admins race only for this first immutable claim. Once
         created, no additional Admin can become Owner from the client. */
      allow create: if administrator()
        && !systemAccessExists()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'createdAt', 'createdBy'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    /* Training/course collections stay fail-closed until they are migrated from
       local device storage and receive UID/course-membership rules. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
