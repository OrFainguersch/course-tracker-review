rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && currentUserRecord().data.status == 'active';
    }

    function owner() {
      return activeUser()
        && currentUserRecord().data.role == 'owner';
    }

    function administrator() {
      return activeUser()
        && currentUserRecord().data.role in ['owner', 'admin'];
    }

    function userManager() {
      return activeUser()
        && currentUserRecord().data.role in ['owner', 'admin', 'training_manager'];
    }

    function systemAccessExists() {
      return exists(/databases/$(database)/documents/system/access);
    }

    function systemOwnerUid() {
      return get(/databases/$(database)/documents/system/access).data.ownerUid;
    }

    function validRoleAndStatus(data) {
      return data.role in ['user', 'duty_trainee', 'training_manager', 'admin', 'owner']
        && data.status in ['pending', 'active', 'blocked'];
    }

    function validUserShape(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'displayName', 'preferredName', 'photoURL', 'providerIds',
        'role', 'status', 'createdAt', 'lastLoginAt', 'updatedAt', 'updatedBy'
      ]) && validRoleAndStatus(data);
    }

    function validInviteShape(data) {
      return data.keys().hasOnly([
        'email', 'displayName', 'role', 'status',
        'createdAt', 'updatedAt', 'invitedBy'
      ])
        && data.email == data.email.lower()
        && data.role in ['user', 'duty_trainee', 'training_manager', 'admin', 'owner']
        && data.status == 'active';
    }

    function invitedUserCreate(data) {
      let email = request.auth.token.email.lower();
      return exists(/databases/$(database)/documents/invitations/$(email))
        && get(/databases/$(database)/documents/invitations/$(email)).data.email == email
        && get(/databases/$(database)/documents/invitations/$(email)).data.status == 'active'
        && data.email == email
        && data.role == get(/databases/$(database)/documents/invitations/$(email)).data.role
        && data.status == 'active';
    }

    function selfProfileOnly(uid) {
      return ownUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          resource.data.role == 'duty_trainee'
          ? ['photoURL', 'providerIds', 'lastLoginAt', 'updatedAt']
          : ['preferredName', 'photoURL', 'providerIds', 'lastLoginAt', 'updatedAt']
        );
    }

    function ownerSelfIdentity(uid) {
      return owner()
        && ownUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'preferredName', 'photoURL', 'updatedAt', 'updatedBy'
        ]);
    }

    function ownerBootstrap(uid) {
      return ownUser(uid)
        && resource.data.role == 'admin'
        && resource.data.status == 'active'
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && systemAccessExists()
        && systemOwnerUid() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'updatedAt', 'updatedBy'
        ]);
    }

    function roleMayBeGranted(actorRole, nextRole) {
      return (actorRole == 'owner' && nextRole in ['owner', 'admin', 'training_manager', 'duty_trainee', 'user'])
        || (actorRole == 'admin' && nextRole in ['training_manager', 'duty_trainee', 'user'])
        || (actorRole == 'training_manager' && nextRole in ['duty_trainee', 'user']);
    }

    function managerMayTarget(actorRole, targetRole, uid) {
      return uid != request.auth.uid
        && !(targetRole == 'owner' && systemAccessExists() && uid == systemOwnerUid())
        && ((actorRole == 'owner')
          || (actorRole == 'admin' && targetRole in ['training_manager', 'duty_trainee', 'user'])
          || (actorRole == 'training_manager' && targetRole in ['duty_trainee', 'user']));
    }

    function managerManagesOther(uid) {
      let actorRole = currentUserRecord().data.role;
      let currentRole = resource.data.role;
      let nextRole = request.resource.data.role;
      return userManager()
        && managerMayTarget(actorRole, currentRole, uid)
        && (nextRole == currentRole
          || roleMayBeGranted(actorRole, nextRole)
          || (actorRole == 'owner'
            && ((currentRole == 'owner' && nextRole in ['admin', 'training_manager', 'user'])
              || (currentRole == 'admin' && nextRole in ['training_manager', 'duty_trainee', 'user'])
              || (currentRole == 'training_manager' && nextRole in ['duty_trainee', 'user'])))
          || (actorRole == 'admin'
            && currentRole == 'training_manager'
            && nextRole == 'user'));
    }

    function managerMayDelete(uid) {
      let actorRole = currentUserRecord().data.role;
      let targetRole = resource.data.role;
      return userManager()
        && managerMayTarget(actorRole, targetRole, uid);
    }

    function mayManageInvitationRole(role) {
      let actorRole = currentUserRecord().data.role;
      return userManager()
        && (actorRole == 'owner'
          || (actorRole == 'admin' && role in ['training_manager', 'duty_trainee', 'user'])
          || (actorRole == 'training_manager' && role in ['duty_trainee', 'user']));
    }

    function mayGrantInvitationRole(role) {
      return userManager()
        && roleMayBeGranted(currentUserRecord().data.role, role);
    }

    match /users/{uid} {
      /* First sign-in may only create the caller's own pending USER record.
         A valid invitation may pre-authorize the exact role granted by the
         inviter's hierarchy: Owner -> Owner/Admin, Admin -> Training Manager,
         Training Manager -> User. The immutable /system/access ownerUid still
         identifies the protected Primary Owner. */
      allow create: if ownUser(uid)
        && validUserShape(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && ((request.resource.data.role == 'user'
          && request.resource.data.status == 'pending')
          || invitedUserCreate(request.resource.data));

      allow read: if ownUser(uid) || userManager();

      /* User Management is hierarchical. Owner may appoint another Owner or an
         Administrator; Admin may appoint a Training Manager; Training Manager
         may appoint a User. Managers may approve/block lower roles, while the
         Primary Owner in /system/access remains protected. */
      allow update: if validUserShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (managerManagesOther(uid)
          || ownerBootstrap(uid)
          || ownerSelfIdentity(uid)
          || selfProfileOnly(uid));

      allow delete: if managerMayDelete(uid);
    }

    match /invitations/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list: if userManager();
      allow create: if userManager()
        && validInviteShape(request.resource.data)
        && request.resource.data.email == email
        && mayGrantInvitationRole(request.resource.data.role);
      allow update: if userManager()
        && validInviteShape(request.resource.data)
        && request.resource.data.email == email
        && mayManageInvitationRole(resource.data.role)
        && (request.resource.data.role == resource.data.role
          || mayGrantInvitationRole(request.resource.data.role));
      allow delete: if userManager()
        && mayManageInvitationRole(resource.data.role);
    }

    match /system/access {
      allow read: if administrator();

      /* Existing legacy Admins race only for this first immutable claim. Once
         created, no additional Admin can become Owner from the client. */
      allow create: if administrator()
        && !systemAccessExists()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'createdAt', 'createdBy'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    /* Shared Safety is an explicitly enrolled, UID-verified exception to the
       device-local training store. The client cannot grant course access. */
    match /courseSafety/{courseId} {
      function member() {
        return activeUser()
          && exists(/databases/$(database)/documents/courseSafety/$(courseId))
          && request.auth.uid in get(/databases/$(database)/documents/courseSafety/$(courseId)).data.members.keys();
      }
      function manager() {
        return userManager()
          || (member()
            && get(/databases/$(database)/documents/courseSafety/$(courseId)).data.members[request.auth.uid].role == 'COURSE_MANAGER');
      }
      function memberUids() {
        return get(/databases/$(database)/documents/courseSafety/$(courseId)).data.members.keys().toSet();
      }

      allow get: if userManager() || member();
      allow list: if activeUser()
        && request.auth.uid in resource.data.memberUids;
      allow create: if userManager()
        && request.resource.data.keys().hasOnly(['courseId','name','members','memberUids','unmatchedEmails','updatedAt','updatedBy'])
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 100
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.toSet() == request.resource.data.members.keys().toSet()
        && request.resource.data.unmatchedEmails is list
        && request.resource.data.unmatchedEmails.size() <= 100
        && request.auth.uid in request.resource.data.members.keys()
        && request.resource.data.members[request.auth.uid].role == 'COURSE_MANAGER'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if userManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','memberUids','unmatchedEmails','updatedAt','updatedBy'])
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 100
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.toSet() == request.resource.data.members.keys().toSet()
        && request.resource.data.unmatchedEmails is list
        && request.resource.data.unmatchedEmails.size() <= 100
        && request.auth.uid in request.resource.data.members.keys()
        && request.resource.data.members[request.auth.uid].role == 'COURSE_MANAGER'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /events/{eventId} {
        function eventKeys() {
          return ['id','courseId','date','traineeId','instructorId','traineeName',
            'instructorName','title','severity','classification','details','briefDescription',
            'findings','lessonsLearned','photos','status','createdBy','createdAt',
            'requiredAckUids','requiredAckNames','seenBy','ackBy','statusBy','statusAt'];
        }
        function ownMark(field) {
          return member()
            && request.auth.uid in resource.data.requiredAckUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
            && request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in resource.data[field].keys())
            && request.resource.data[field][request.auth.uid] == request.time;
        }
        allow get, list: if member() || userManager();
        allow create: if member()
          && request.resource.data.keys().hasOnly(eventKeys())
          && request.resource.data.id == eventId
          && request.resource.data.courseId == get(/databases/$(database)/documents/courseSafety/$(courseId)).data.courseId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'OPEN'
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 250
          && request.resource.data.seenBy == {}
          && request.resource.data.ackBy == {}
          && request.resource.data.requiredAckUids is list
          && request.resource.data.requiredAckUids.toSet() == memberUids();
        allow update: if ownMark('seenBy')
          || (ownMark('ackBy') && request.auth.uid in resource.data.seenBy.keys())
          || (manager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusBy','statusAt'])
            && request.resource.data.status in ['OPEN','IN_PROGRESS','RESOLVED']
            && request.resource.data.statusBy == request.auth.uid
            && request.resource.data.statusAt == request.time);
        allow delete: if false;
      }
    }

    /* BEGIN FLYMPUS COURSE OPERATIONS */
    /* Additive shared channel. Local training data is never migrated implicitly. */
    match /courseOperations/{courseId} {
      function opsCourse() { return get(/databases/$(database)/documents/courseOperations/$(courseId)).data; }
      function opsMember() {
        return activeUser() && exists(/databases/$(database)/documents/courseOperations/$(courseId))
          && request.auth.uid in opsCourse().members.keys();
      }
      function opsReviewer() {
        return opsMember() && currentUserRecord().data.role != 'duty_trainee'
          && opsCourse().members[request.auth.uid].role in ['INSTRUCTOR', 'COURSE_MANAGER'];
      }
      function opsAfterReviewer() {
        let course = getAfter(/databases/$(database)/documents/courseOperations/$(courseId)).data;
        return activeUser() && currentUserRecord().data.role != 'duty_trainee'
          && request.auth.uid in course.members.keys()
          && course.members[request.auth.uid].role in ['INSTRUCTOR', 'COURSE_MANAGER'];
      }
      function opsManager() {
        return userManager() && (administrator()
          || !exists(/databases/$(database)/documents/courseOperations/$(courseId))
          || (opsMember() && opsCourse().members[request.auth.uid].role == 'COURSE_MANAGER'));
      }
      function opsRevision(date) {
        return exists(/databases/$(database)/documents/courseOperations/$(courseId)/days/$(date))
          ? get(/databases/$(database)/documents/courseOperations/$(courseId)/days/$(date)).data.revision : 0;
      }
      function opsDate(date) { return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
      function opsPlan(p) { return p is map && p.keys().hasOnly(['flights']) && p.flights is list && p.flights.size() <= 100; }
      function opsReport(p) {
        return p is map && p.keys().hasOnly(['date','plannedInstructed','plannedSolo','instructedExecuted','soloExecuted','cancellations','reason','solos'])
          && opsDate(p.date) && p.plannedInstructed is int && p.plannedInstructed >= 0 && p.plannedInstructed <= 100
          && p.plannedSolo is int && p.plannedSolo >= 0 && p.plannedSolo <= 500
          && p.plannedInstructed + p.plannedSolo > 0
          && p.instructedExecuted is int && p.instructedExecuted >= 0 && p.instructedExecuted <= 10000
          && p.solos is list && p.solos.size() <= 500 && p.soloExecuted == p.solos.size() && p.soloExecuted <= p.plannedSolo
          && p.cancellations is list && p.cancellations.size() <= 600 && p.reason is string && p.reason.size() <= 10000;
      }
      function opsPayload(kind,p) { return (kind == 'PLAN' && opsPlan(p)) || (kind == 'REPORT' && opsReport(p)); }
      function opsCourseShape(v) {
        return v.keys().hasOnly(['courseId','name','context','members','memberUids','updatedBy','updatedAt'])
          && v.courseId is string && v.courseId.size() > 0 && v.courseId.size() <= 120
          && v.name is string && v.name.size() <= 160 && v.context is map
          && v.context.keys().hasOnly(['courseMeta','trainees','instructors','syllabi','soloSyllabi','syllabusDefs','counters','cancellationReasons'])
          && v.context.courseMeta is map && v.context.trainees is list && v.context.trainees.size() <= 100
          && v.context.instructors is list && v.context.instructors.size() <= 100
          && v.context.syllabi is list && v.context.soloSyllabi is list && v.context.syllabusDefs is list
          && v.context.counters is list && v.context.cancellationReasons is list
          && v.members is map && v.members.size() <= 200 && v.memberUids is list
          && v.memberUids.toSet() == v.members.keys().toSet()
          && request.auth.uid in v.members.keys() && v.members[request.auth.uid].role == 'COURSE_MANAGER'
          && v.updatedBy == request.auth.uid && v.updatedAt == request.time;
      }
      allow get: if opsMember() || opsManager();
      allow list: if activeUser() && request.auth.uid in resource.data.memberUids;
      allow create: if opsManager() && opsCourseShape(request.resource.data);
      allow update: if opsManager() && opsCourseShape(request.resource.data)
        && request.resource.data.courseId == resource.data.courseId;
      allow delete: if false;

      match /fleet/{fleetId} {
        function fleetShape(v) {
          let c = getAfter(/databases/$(database)/documents/courseOperations/$(courseId)).data;
          return fleetId == 'current' && v.keys().hasOnly(['platformId','aircraft','timingDefaults','revision','updatedBy','updatedAt'])
            && v.platformId == c.context.courseMeta.platformId && v.aircraft is list && v.aircraft.size() <= 100
            && v.timingDefaults is map && v.revision is int
            && v.updatedBy == request.auth.uid && v.updatedAt == request.time;
        }
        allow read: if opsMember();
        allow create: if opsAfterReviewer() && fleetShape(request.resource.data) && request.resource.data.revision == 0;
        allow update: if opsMember() && fleetShape(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      match /days/{date} {
        function dayShape(v) {
          return v.keys().hasOnly(['date','revision','plan','report','evaluationCount','sourceRequestId','updatedBy','updatedAt'])
            && opsDate(date) && v.date == date && v.revision is int && v.revision > 0
            && (v.plan == null || opsPlan(v.plan)) && (v.report == null || (opsReport(v.report) && v.report.date == date))
            && v.evaluationCount is int && v.evaluationCount >= 0 && v.evaluationCount <= 10000
            && v.sourceRequestId is string && v.sourceRequestId.size() <= 100
            && v.updatedBy == request.auth.uid && v.updatedAt == request.time;
        }
        function approvedRequest(v) {
          let r = getAfter(/databases/$(database)/documents/courseOperations/$(courseId)/requests/$(v.sourceRequestId)).data;
          let existed = exists(/databases/$(database)/documents/courseOperations/$(courseId)/days/$(date));
          return r.status == 'APPROVED' && r.date == date && r.courseId == opsCourse().courseId
            && r.reviewedBy == request.auth.uid && r.submittedBy != request.auth.uid
            && r.baseRevision == opsRevision(date) && v.revision == r.baseRevision + 1
            && ((r.kind == 'PLAN' && v.plan == r.payload && (!existed || v.report == resource.data.report))
              || (r.kind == 'REPORT' && v.report == r.payload && (!existed || v.plan == resource.data.plan)))
            && (!existed || v.evaluationCount == resource.data.evaluationCount);
        }
        allow read: if opsMember();
        allow create: if opsAfterReviewer() && dayShape(request.resource.data) && request.resource.data.revision == 1
          && (request.resource.data.sourceRequestId == '' || approvedRequest(request.resource.data));
        allow update: if opsReviewer() && dayShape(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && (request.resource.data.sourceRequestId == '' || approvedRequest(request.resource.data));
        allow delete: if false;
      }
      match /requests/{requestId} {
        function requestShape(v) {
          return v.keys().hasOnly(['id','courseId','kind','date','payload','baseRevision','status','submittedBy','submittedName','submittedAt','reviewedBy','reviewedAt','reviewNote'])
            && v.id == requestId && requestId.matches('^[a-zA-Z0-9_-]{8,100}$')
            && v.courseId == opsCourse().courseId && opsDate(v.date) && opsPayload(v.kind,v.payload)
            && (v.kind != 'REPORT' || v.payload.date == v.date)
            && v.baseRevision is int && v.baseRevision >= 0
            && v.submittedName is string && v.submittedName.size() <= 120
            && v.reviewNote is string && v.reviewNote.size() <= 2000;
        }
        function atomicApproval(v) {
          let d = getAfter(/databases/$(database)/documents/courseOperations/$(courseId)/days/$(v.date)).data;
          return v.baseRevision == opsRevision(v.date) && d.sourceRequestId == requestId
            && d.updatedBy == request.auth.uid && d.updatedAt == request.time && d.revision == v.baseRevision + 1
            && ((v.kind == 'PLAN' && d.plan == v.payload) || (v.kind == 'REPORT' && d.report == v.payload));
        }
        allow read: if opsMember() && (opsReviewer() || resource == null || resource.data.submittedBy == request.auth.uid);
        allow create: if opsMember() && currentUserRecord().data.role == 'duty_trainee'
          && opsCourse().members[request.auth.uid].role == 'DUTY_TRAINEE'
          && requestShape(request.resource.data) && request.resource.data.status == 'PENDING'
          && request.resource.data.baseRevision == opsRevision(request.resource.data.date)
          && request.resource.data.submittedBy == request.auth.uid && request.resource.data.submittedAt == request.time
          && request.resource.data.reviewedBy == '' && request.resource.data.reviewedAt == null && request.resource.data.reviewNote == '';
        allow update: if opsMember() && requestShape(request.resource.data) && resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','reviewNote'])
          && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
          && ((request.resource.data.status == 'WITHDRAWN' && resource.data.submittedBy == request.auth.uid && request.resource.data.reviewNote == '')
            || (opsReviewer() && resource.data.submittedBy != request.auth.uid
              && ((request.resource.data.status == 'RETURNED' && request.resource.data.reviewNote.size() > 0)
                || (request.resource.data.status == 'APPROVED' && atomicApproval(request.resource.data)))));
        allow delete: if false;
      }
    }
    /* END FLYMPUS COURSE OPERATIONS */

    /* Other training/course collections remain fail-closed until a separate
       migration from device storage and complete UID/course rules. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
